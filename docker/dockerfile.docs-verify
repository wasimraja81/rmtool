# Verifies BUILD.md/QUICKSTART.md's own documented install steps are
# sufficient for a real user, by following them literally: installs
# ONLY the packages those docs list, then drives the build through
# ./build.sh and scripts/setup_venv.sh -- not docker/dockerfile's own
# separate `make` calls and pre-installed system Python packages,
# which exercise a different, maintainer-curated path and would not
# have caught a gap in the documented one (confirmed: this is how the
# project first found BUILD.md/QUICKSTART.md never having said to
# install python3 at all -- docker/dockerfile pre-installs it, so that
# check alone never exercised the gap). Not meant to be published as
# an image -- CI-only, see .github/workflows/build-and-verify.yml.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

# Exactly BUILD.md's Requirements section (gfortran, CFITSIO, Starlink
# AST + FFTW3, python3/python3-venv/python3-pip) plus `make`
# (QUICKSTART's own minimal-install block). Deliberately nothing else
# -- no pre-installed astropy/matplotlib/etc. -- so build.sh's own
# venv auto-setup is what has to make Python tooling work.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gfortran \
    make \
    libcfitsio-dev \
    libstarlink-ast-dev libstarlink-ast-err9 libstarlink-ast-grf3d9 libstarlink-pal-dev \
    libfftw3-dev \
    python3 python3-venv python3-pip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app/rmtool
COPY . .

CMD ["/bin/bash"]
